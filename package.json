{
  "name": "app",
  "private": true,
  "scripts": {
    "build:css": "npx tailwindcss -i app/assets/stylesheets/application.css -o app/assets/builds/tailwind.css --content \"app/**/*.{rb,html,erb,js,jsx,ts,tsx}\" \"app/javascript/**/*.{js,jsx,ts,tsx}\" --minify",
    "build": "esbuild app/javascript/*.* --bundle --sourcemap --format=esm --outdir=app/assets/builds --public-path=/assets"
  },
  "dependencies": {
    "@hotwired/stimulus": "^3.2.2",
    "@hotwired/turbo-rails": "^8.0.23",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.28.1",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19"
  }
}