<div class="page-container">
  <div class="page-header">
    <div>
      <p class="page-label">Bugs</p>
      <h1 class="page-title">Create New Bug</h1>
      <p class="page-description">Add the bug details first, then choose the developer for the selected project.</p>
    </div>
    <%= link_to "Back to Bugs", bugs_path, class: "button button-secondary" %>
  </div>

  <% if @projects.empty? %>
    <div class="info-card">
      <p>You do not have any assigned projects yet. Please ask your manager to assign a project before creating a bug.</p>
    </div>
  <% else %>
    <div class="form-card">
      <% if @step == "select_developer" %>
        <h2 class="page-title" style="font-size: 25px; margin-bottom: 20px;">Step 2: Select a developer</h2>

        <%= form_with model: @bug,
            url: bugs_path,
            html: { id: "new-bug-form", multipart: true } do |form| %>

          <%= form.hidden_field :project_id%>
          <%= form.hidden_field :title %>
          <%= form.hidden_field :description %>
          <%= form.hidden_field :deadline %>
          <%= form.hidden_field :bug_type %>

          <div class="form-row">
            <%= form.label "Developer", class: "field-label" %>
            <%= form.collection_select :developer_id,
                @developers,
                :id,
                :name,
                { prompt: "Select developer" },
                { class: @bug.errors[:developer_id].present? ? "input-field input-field-error" : "input-field" } %>
            <% if @bug.errors[:developer_id].present? %>
              <div class="field-error-text">
                <%= @bug.errors.full_messages_for(:developer).first %>
              </div>
            <% end %>
          </div>

          <div class="form-row">
            <%= form.label :screenshot, class: "field-label" %>
            <% preview_src = params.dig(:bug, :image_preview_data_url) %>
            <% has_preview = preview_src.present? %>

            <div class="upload-card" data-controller="image-upload">
              <label for="bug_screenshot" class="upload-target">
                <img
                  class="upload-preview"
                  alt="<%= @bug.title.presence || 'Bug screenshot' %>"
                  src="<%= preview_src %>"
                  data-image-upload-target="preview"
                  <%= 'hidden' unless has_preview %>
                >
                <div class="upload-placeholder" data-image-upload-target="placeholder" <%= 'hidden' if has_preview %>>
                  <div class="upload-icon">+</div>
                  <p class="upload-title">Upload screenshot</p>
                  <p class="upload-hint">PNG, JPG</p>
                </div>
              </label>

              <%= form.file_field :screenshot,
                    id: "bug_screenshot",
                    class: "upload-input",
                    accept: "image/*",
                    data: { image_upload_target: "input", action: "change->image-upload#change" } %>
              <%= form.hidden_field :image_preview_data_url,
                    id: "bug_image_preview_data_url",
                    value: params.dig(:bug, :image_preview_data_url),
                    data: { image_upload_target: "dataUrlField" } %>
              <%= form.hidden_field :image_preview_name,
                    id: "bug_image_preview_name",
                    value: params.dig(:bug, :image_preview_name),
                    data: { image_upload_target: "nameField" } %>
            </div>
          </div>

          <div class="actions-row">
            <%= link_to "Back", new_bug_path, class: "button button-secondary" %>
            <%= form.submit "Create Bug", class: "button button-primary" %>
          </div>
        <% end %>
      <% else %>
        <h2 class="page-title" style="font-size: 25px; margin-bottom: 20px;">Step 1: Bug details</h2>



        <%= form_with model: @bug,
            url: new_bug_path,
            method: :get,
            html: { id: "bug-details-form" } do |form| %>

          <%= hidden_field_tag :step, "select_developer" %>

          <div class="form-row">
            <%= form.label :project_id, "Project", class: "field-label" %>
            <%= form.collection_select :project_id,
                @projects,
                :id,
                :name,
                { prompt: "Select a project" },
                { class: @bug.errors[:project_id].present? ? "input-field input-field-error" : "input-field" } %>
            <% if @bug.errors[:project_id].present? %>
              <div class="field-error-text">
                <%= @bug.errors.full_messages_for(:project_id).first %>
              </div>
            <% end %>
          </div>

          <div class="form-row">
            <%= form.label :title, class: "field-label" %>
            <%= form.text_field :title, class: @bug.errors[:title].present? ? "input-field input-field-error" : "input-field" %>
            <% if @bug.errors[:title].present? %>
              <div class="field-error-text">
                <%= @bug.errors.full_messages_for(:title).first %>
              </div>
            <% end %>
          </div>

          <div class="form-row">
            <%= form.label :description, class: "field-label" %>
            <%= form.text_area :description, class: "input-field", rows: 4 %>
          </div>

          <div class="form-row form-row-split">
            <div>
              <%= form.label :deadline, class: "field-label" %>
              <%= form.date_field :deadline, class: @bug.errors[:deadline].present? ? "input-field input-field-error" : "input-field" %>
              <% if @bug.errors[:deadline].present? %>
                <div class="field-error-text">
                  <%= @bug.errors.full_messages_for(:deadline).first %>
                </div>
              <% end %>
            </div>
            <div>
              <%= form.label :bug_type, class: "field-label" %>
              <%= form.select :bug_type,
                  Bug.bug_types.keys.map { |type| [type.titleize, type] },
                  {},
                  class: @bug.errors[:bug_type].present? ? "input-field input-field-error" : "input-field" %>
              <% if @bug.errors[:bug_type].present? %>
                <div class="field-error-text">
                  <%= @bug.errors.full_messages_for(:bug_type).first %>
                </div>
              <% end %>
            </div>
          </div>

          <div class="actions-row">
            <%= form.submit "Next", class: "button button-primary" %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
