<div class="page-container">
  <div class="page-header">
    <div>
      <p class="page-label">Projects</p>
      <h1 class="page-title">Create Project</h1>
      <p class="page-description">Add a new project and assign QA and developers.</p>
    </div>
  </div>

  <div class="project-form-grid">
    <%= form_with model: @project, html: { multipart: true } do |form| %>

 <% if @project.errors[:base].present? %>
    <div class="field-error-text">
      <%= @project.errors.full_messages_for(:base).first %>
    </div>
  <% end %>


      <div class="form-card project-form-main">
        <div class="project-form-columns">
          <div class="project-form-fields">
            <div class="form-row">
              <%= form.label :name, class: "field-label" %>
              <%= form.text_field :name, class: "input-field" %>
              <% if @project.errors[:name].present? %>
                <div class="field-error-text">
                  <%= @project.errors.full_messages_for(:name).first %>
                </div>
              <% end %>
            </div>

            <div class="form-row">
              <%= form.label :description, class: "field-label" %>
              <%= form.text_area :description, class: "input-field", rows: 4 %>
              <% if @project.errors[:description].present? %>
                <div class="field-error-text">
                  <%= @project.errors.full_messages_for(:description).first %>
                </div>
              <% end %>
            </div>

            <div class="form-row" data-controller="multi-select">
              <p class="field-label">Assign to QA</p>
              <div class="multi-select">
                <details class="multi-select" role="listbox">
                  <summary class="multi-select-summary">Select QA</summary>
                  <div class="multi-select-panel">
                    <% @qas.each do |qa| %>
                      <label class="checkbox-row">
                        <%= check_box_tag "project[qa_user_ids][]", qa.id, @selected_qa_user_ids&.include?(qa.id), multiple: true, id: nil, class: "selection-checkbox", data: { multi_select_target: "checkbox", action: "change->multi-select#update", preview_label: qa.name } %>
                        <span><%= qa.name %></span>
                      </label>
                    <% end %>
                  </div>
                </details>
              </div>
              <div class="selection-preview">
                <span class="selection-preview-label">Selected QA</span>
                <span class="selection-preview-values" data-multi-select-target="preview"><%= @selected_qa_names.presence&.join(", ") || "None selected" %></span>
              </div>
            </div>

            <div class="form-row" data-controller="multi-select">
              <p class="field-label">Select Developers</p>
              <div class="multi-select">
                <details class="multi-select" role="listbox">
                  <summary class="multi-select-summary">Select Developers</summary>
                  <div class="multi-select-panel">
                    <% @developers.each do |developer| %>
                      <label class="checkbox-row">
                        <%= check_box_tag "project[developer_user_ids][]", developer.id, @selected_developer_user_ids&.include?(developer.id), multiple: true, id: nil, class: "selection-checkbox", data: { multi_select_target: "checkbox", action: "change->multi-select#update", preview_label: developer.name } %>
                        <span><%= developer.name %></span>
                      </label>
                    <% end %>
                  </div>
                </details>
              </div>
              <div class="selection-preview">
                <span class="selection-preview-label">Selected Developers</span>
                <span class="selection-preview-values" data-multi-select-target="preview"><%= @selected_developer_names.presence&.join(", ") || "None selected" %></span>
              </div>
            </div>
          </div>

          <aside class="project-form-sidebar">
            <% preview_src = params.dig(:project, :image_preview_data_url) %>
            <% has_preview = preview_src.present? %>

            <div class="upload-card" data-controller="image-upload">
              <label for="project_image" class="upload-target">
                <img
                  class="upload-preview"
                  alt="<%= @project.name.presence || 'Project logo' %>"
                  src="<%= preview_src %>"
                  data-image-upload-target="preview"
                  <%= 'hidden' unless has_preview %>
                >
                
                <div class="upload-placeholder" data-image-upload-target="placeholder" <%= 'hidden' if has_preview %>>
                  <div class="upload-icon">+</div>
                  <p class="upload-title">Upload logo</p>
                  <p class="upload-hint">PNG, JPG</p>
                </div>
              </label>

              <%= form.file_field :image, id: "project_image", accept: "image/png,image/jpeg,image",
                    class: "upload-input",
                    data: { image_upload_target: "input", action: "change->image-upload#change" } %>
              <%= form.hidden_field :image_preview_data_url, id: "project_image_preview_data_url",
                    value: params.dig(:project, :image_preview_data_url),
                    data: { image_upload_target: "dataUrlField" } %>
              <%= form.hidden_field :image_preview_name, id: "project_image_preview_name",
                    value: params.dig(:project, :image_preview_name),
                    data: { image_upload_target: "nameField" } %>
            </div>

            <% if @project.errors[:image].present? %>
              <div class="field-error-text">
                <%= @project.errors.full_messages_for(:image).first %>
              </div>
            <% end %>
          </aside>
        </div>

        <div class="actions-row">
          <%= form.submit "Create Project", class: "button button-primary" %>
          <%= link_to "Cancel", projects_path, class: "button button-secondary" %>
        </div>
      </div>
    <% end %>
  </div>
</div>
